# Never commit a real API key. Keep it on the server only.
PORT=3000
HOST=127.0.0.1
# Set true only for the launcher's same-home-Wi-Fi mode. It rejects public client IPs.
LAN_ONLY=false
# Docker Compose host binding; keep loopback for VPS/reverse-proxy use.
BIND_ADDRESS=127.0.0.1
# Token budget guards for affordable API usage (rough estimate; provider tokenizers vary).
MAX_INPUT_TOKENS=1800
MEMORY_SUMMARY_CHARS=900
MAX_OUTPUT_TOKENS=500
CONTEXT_LOGIC_TEMP=0.6
AI_API_KEY=
# Optional: comma-separated HTTPS hostnames for custom OpenAI-compatible server providers.
CUSTOM_ENDPOINT_HOSTS=
# Launcher selects runtime mode. Public/reverse-proxy hosts should use vps.
RUNTIME_MODE=local
# Explicit opt-in, private local/LAN only. VPS runtime always forces this off.
ALLOW_CLIENT_API_KEYS=false
# Browser-key passthrough is restricted to these HTTPS provider hosts.
CLIENT_KEY_HOSTS=api.openai.com,openrouter.ai
