# Environment & Secrets (NEVER COMMIT)
.env
.env.*
.env.local
!.env.example

# Runtime & User Data (Characters, Chats, Settings, Uploaded Artwork, Sessions)
/data/*
!/data/uploads/
/data/uploads/*
!/data/uploads/.gitkeep

# Temporary, Logs & Backups
*.log
*.tmp
*.bak
*.swp
*~
npm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Node
/node_modules/

# Keep self-hosting launchers and container recipes trackable
!.dockerignore
!Dockerfile
!compose.yaml
!README-LINUX.md
!install-linux.sh

